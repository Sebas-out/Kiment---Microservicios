# ==============================================================================
# KIMENTS POS — Configuracion de Referencia de Nginx (Reverse Proxy HTTPS)
# ==============================================================================

# Limitar tasa de solicitudes a nivel de proxy inverso
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;

server {
    listen 80;
    server_name pos.kiments.com;
    # Redireccion forzosa a HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pos.kiments.com;

    # Certificados SSL/TLS (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/pos.kiments.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos.kiments.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Cabeceras de Seguridad HTTP
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';" always;

    # Tamaño maximo de subida (alineado con max 2 MB para avatares)
    client_max_body_size 5M;

    # --------------------------------------------------------------------------
    # 1. Frontend Next.js (BFF y UI)
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # --------------------------------------------------------------------------
    # 2. Rutas del Backend SVC-09 (si se exponen mediante subruta /api/v1/auth)
    # Nota: Si Next.js actúa como BFF completo en el servidor, las llamadas
    # van directamente por la red interna Docker (http://auth-service:8080)
    # y este bloque solo es necesario si el navegador consume el API directamente.
    # --------------------------------------------------------------------------
    location /api/v1/ {
        limit_req zone=api_limit burst=10 nodelay;

        proxy_pass http://auth-service:8080/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bloque especifico para endurecer login contra fuerza bruta
    location /api/v1/auth/login {
        limit_req zone=login_limit burst=3 nodelay;

        proxy_pass http://auth-service:8080/api/v1/auth/login;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --------------------------------------------------------------------------
    # 3. Proteccion de Actuator: Prohibido exponer publicamente
    # --------------------------------------------------------------------------
    location /actuator/ {
        # Bloquear acceso desde Internet exterior; solo admitir redes internas o localhost
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://auth-service:8080/actuator/;
        proxy_set_header Host $host;
    }
}
