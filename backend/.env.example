# Plantilla: Spring NO carga este archivo automáticamente. Exportar variables al proceso.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/kiments_db
DB_USERNAME=kiments_auth
DB_PASSWORD=
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=kiments-api
JWT_KEY_ID=kiments-rsa-1
# Rutas URI a claves externas al repositorio; completar según la salida de New-DevKeys.ps1.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Vacío para BFF servidor a servidor; para acceso directo: http://localhost:3000
CORS_ORIGINS=
PORT=8080
# Bootstrap automático: solo dev y primera instalación. Deshabilitado por defecto.
APP_BOOTSTRAP_ADMIN_ENABLED=false
# Procedimiento manual sin HTTP (también para producción); no activar en arranque normal.
APP_BOOTSTRAP_ADMIN_MANUAL_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_FIRST_NAME=
APP_BOOTSTRAP_ADMIN_LAST_NAME=
APP_BOOTSTRAP_ADMIN_DNI=
# Solo variable temporal en memoria, nunca guardar la contraseña en .env:
# APP_BOOTSTRAP_ADMIN_PASSWORD
