# ============================================================
# Kiments Catalog & Inventory Service (MS-02)
# Archivo de variables de entorno de ejemplo para desarrollo y despliegue
# NO colocar secretos reales en este archivo
# ============================================================

# Servidor
PORT=8082

# Base de datos PostgreSQL (Esquema catalog_inventory)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kiments_db
DB_USER=kiments_catalog
DB_PASSWORD=kiments_catalog_secure_password
DB_POOL_MAX=10
DB_POOL_MIN=2

# Integración con MS-01 Auth Service
AUTH_JWKS_URI=http://localhost:8080/api/v1/auth/jwks
AUTH_ISSUER=https://kiments-auth-service
AUTH_AUDIENCE=kiments-auth
AUTH_ME_URI=http://localhost:8080/api/v1/auth/me
AUTH_VALIDATE_SESSION_REMOTELY=false

# Almacenamiento de imágenes de productos
STORAGE_LOCAL_DIR=./storage/catalog-images

# CORS (Orígenes explícitos separados por comas, sin comodines)
CORS_ORIGINS=http://localhost:3000
